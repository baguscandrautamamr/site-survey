rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Banned users keep a valid Firebase Auth session until the client signs
    // them out, so every rule below must check the ban server-side too.
    function isActive() {
      return isSignedIn() &&
        !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
    }
    function isAdmin() {
      return isActive() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isProjectMember(projectId) {
      return isActive() &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
    }

    match /users/{uid} {
      allow read: if isActive();
      // Users may create and edit their own profile, but never pick or change
      // their own role: only an admin can promote or demote.
      allow create: if isAdmin() ||
        (isActive() && request.auth.uid == uid && request.resource.data.role == 'member');
      allow update: if isAdmin() ||
        (isActive() && request.auth.uid == uid &&
          request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isAdmin();
    }

    match /bannedUsers/{uid} {
      // Must stay readable with plain isSignedIn() so a banned client can
      // detect its own ban and sign out.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /assetTypes/{assetTypeId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, update, delete: if isActive() &&
        (isAdmin() || request.auth.uid in resource.data.get('memberUids', []));
      allow create: if isActive() && request.auth.uid in request.resource.data.memberUids;

      match /plans/{planId} {
        allow read, write: if isProjectMember(projectId) || isAdmin();

        match /pins/{pinId} {
          allow read, write: if isProjectMember(projectId) || isAdmin();
        }
      }

      match /tasks/{taskId} {
        allow read, write: if isProjectMember(projectId) || isAdmin();
      }
    }

    // Collection-group access for admin-wide queries (e.g. the photo gallery,
    // which lists pins across every project). Kept separate from the nested
    // /projects/{projectId}/plans/{planId}/pins/{pinId} rule above because an
    // unfiltered collectionGroup('pins') query can't be statically validated
    // against a rule that depends on resource.data or a path-bound projectId.
    match /{path=**}/pins/{pinId} {
      allow read, write: if isAdmin();
    }
  }
}
