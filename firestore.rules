rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isProjectMember(projectId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /bannedUsers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, update, delete: if isSignedIn() &&
        (isAdmin() || request.auth.uid in resource.data.get('memberUids', []));
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;

      match /plans/{planId} {
        allow read, write: if isProjectMember(projectId) || isAdmin();

        match /pins/{pinId} {
          allow read, write: if isProjectMember(projectId) || isAdmin();
        }
      }

      match /tasks/{taskId} {
        allow read, write: if isProjectMember(projectId) || isAdmin();
      }
    }

    // Collection-group access for admin-wide queries (e.g. the photo gallery,
    // which lists pins across every project). Kept separate from the nested
    // /projects/{projectId}/plans/{planId}/pins/{pinId} rule above because an
    // unfiltered collectionGroup('pins') query can't be statically validated
    // against a rule that depends on resource.data or a path-bound projectId.
    match /{path=**}/pins/{pinId} {
      allow read, write: if isAdmin();
    }
  }
}
