<Window x:Class="BOMExport.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOM Export — Electrical"
        Width="580" Height="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ── Card normal ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Sub-info ── -->
        <Style x:Key="SubInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="28,2,0,0"/>
        </Style>

        <!-- ── Preset chip button ── -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button ── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#1A2B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#243B5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button ── -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ── -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Converters ── -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1A2B45">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BOM EXPORT" Foreground="#F5A623" FontSize="10"
                               FontWeight="Bold" LetterSpacing="3"/>
                    <TextBlock Text="Electrical Bill of Materials" Foreground="White"
                               FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock Text="Export data material ke Excel dengan format profesional"
                               Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#243B5E" CornerRadius="4"
                        Padding="8,4" VerticalAlignment="Top">
                    <TextBlock Text="v1.1" Foreground="#F5A623" FontSize="10" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ CONTENT ═════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>

                <!-- Output File -->
                <TextBlock Text="OUTPUT FILE" FontSize="9" FontWeight="Bold"
                           Foreground="#94A3B8" Margin="0,0,0,6" LetterSpacing="1.5"/>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFilePath" Style="{StaticResource InputStyle}"
                                 IsReadOnly="True" Text="Pilih lokasi penyimpanan file..."
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="📁  Browse"
                                Style="{StaticResource BtnSecondary}"
                                Margin="8,0,0,0" Click="BrowseFile_Click"/>
                    </Grid>
                </Border>

                <StackPanel Height="10"/>

                <!-- ══ KATEGORI ══════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FILTER KATEGORI" FontSize="9" FontWeight="Bold"
                               Foreground="#94A3B8" LetterSpacing="1.5" VerticalAlignment="Center"/>
                    <!-- Total badge -->
                    <Border Grid.Column="1" Background="#1A2B45" CornerRadius="10" Padding="10,3">
                        <TextBlock x:Name="TxtTotalCount" Text="0 grup"
                                   Foreground="#F5A623" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- Preset chips -->
                <Border Background="White" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect Color="#CBD5E1" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Pilih Cepat:" FontSize="10" Foreground="#64748B"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <!-- Semua -->
                            <Button Content="✅  Semua" Style="{StaticResource ChipBtn}"
                                    Background="#1A2B45" Foreground="White"
                                    BorderBrush="#1A2B45" Margin="0,0,6,4"
                                    Click="Preset_All"/>
                            <!-- Hanya Lighting -->
                            <Button Content="💡  Lighting Only" Style="{StaticResource ChipBtn}"
                                    Background="#FEF3C7" Foreground="#92400E"
                                    BorderBrush="#F59E0B" Margin="0,0,6,4"
                                    Click="Preset_Lighting"/>
                            <!-- Hanya Power -->
                            <Button Content="🔌  Power Only" Style="{StaticResource ChipBtn}"
                                    Background="#DBEAFE" Foreground="#1D4ED8"
                                    BorderBrush="#3B82F6" Margin="0,0,6,4"
                                    Click="Preset_Power"/>
                            <!-- Low Current -->
                            <Button Content="📡  Low Current" Style="{StaticResource ChipBtn}"
                                    Background="#D1FAE5" Foreground="#065F46"
                                    BorderBrush="#10B981" Margin="0,0,6,4"
                                    Click="Preset_LowCurrent"/>
                            <!-- None -->
                            <Button Content="✕  Kosongkan" Style="{StaticResource ChipBtn}"
                                    Background="#F1F5F9" Foreground="#6B7280"
                                    BorderBrush="#CBD5E1" Margin="0,0,0,4"
                                    Click="Preset_None"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Select All toggle -->
                <Border Background="#EFF6FF" CornerRadius="6" Padding="12,7" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkAll" Content="Centang / Hapus Semua Kategori"
                              FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"
                              Checked="ChkAll_Checked" Unchecked="ChkAll_Unchecked"/>
                </Border>

                <!-- ── 6 Category Cards ──────────────────────────────────── -->

                <!-- 1. Lighting -->
                <Border x:Name="CardLighting" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="#F59E0B"
                                CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkLighting" IsChecked="True"
                                      Checked="Category_Changed" Unchecked="Category_Changed"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <TextBlock>
                                    <Run Text="💡 " FontSize="15"/>
                                    <Run Text="Lighting Fixtures"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource SubInfo}"
                                       Text="Qty · Watt · Circuit · Panel · Room · Level"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="BadgeLighting"
                                Background="#FEF3C7" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtLightCount" Text="—"
                                       FontSize="10" Foreground="#92400E" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Receptacle -->
                <Border x:Name="CardReceptacle" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="#3B82F6"
                                CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkReceptacle" IsChecked="True"
                                      Checked="Category_Changed" Unchecked="Category_Changed"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <TextBlock>
                                    <Run Text="🔌 " FontSize="15"/>
                                    <Run Text="Receptacle / Stop Kontak"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource SubInfo}"
                                       Text="Qty · Watt · Circuit · Panel · Room · Level"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="BadgeReceptacle"
                                Background="#DBEAFE" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtRecepCount" Text="—"
                                       FontSize="10" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Cable Tray -->
                <Border x:Name="CardCableTray" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="#6366F1"
                                CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkCableTray" IsChecked="True"
                                      Checked="Category_Changed" Unchecked="Category_Changed"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <TextBlock>
                                    <Run Text="📦 " FontSize="15"/>
                                    <Run Text="Cable Tray"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource SubInfo}"
                                       Text="Qty · Dimensi · Level · Workset · Type · Panjang"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="BadgeCableTray"
                                Background="#EDE9FE" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtCTrayCount" Text="—"
                                       FontSize="10" Foreground="#4F46E5" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4. Public Address -->
                <Border x:Name="CardPA" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="#10B981"
                                CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkPA" IsChecked="True"
                                      Checked="Category_Changed" Unchecked="Category_Changed"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <TextBlock>
                                    <Run Text="📢 " FontSize="15"/>
                                    <Run Text="Public Address"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource SubInfo}"
                                       Text="Qty · Watt · Room · Level"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="BadgePA"
                                Background="#D1FAE5" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtPACount" Text="—"
                                       FontSize="10" Foreground="#065F46" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 5. Fire Alarm -->
                <Border x:Name="CardFireAlarm" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="#EF4444"
                                CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkFireAlarm" IsChecked="True"
                                      Checked="Category_Changed" Unchecked="Category_Changed"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <TextBlock>
                                    <Run Text="🔔 " FontSize="15"/>
                                    <Run Text="Fire Alarm"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource SubInfo}"
                                       Text="Qty · Room · Level"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="BadgeFireAlarm"
                                Background="#FEE2E2" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtFACount" Text="—"
                                       FontSize="10" Foreground="#B91C1C" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 6. Data -->
                <Border x:Name="CardData" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="#8B5CF6"
                                CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ChkData" IsChecked="True"
                                      Checked="Category_Changed" Unchecked="Category_Changed"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                      VerticalContentAlignment="Center" Cursor="Hand">
                                <TextBlock>
                                    <Run Text="🖧 " FontSize="15"/>
                                    <Run Text="Data / Network Point"/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource SubInfo}"
                                       Text="Qty · Room · Level"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="BadgeData"
                                Background="#EDE9FE" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="TxtDataCount" Text="—"
                                       FontSize="10" Foreground="#6D28D9" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Height="10"/>

                <!-- ══ FILTER LEVEL ══════════════════════════════════════════ -->
                <TextBlock Text="FILTER PER LEVEL" FontSize="9" FontWeight="Bold"
                           Foreground="#94A3B8" Margin="0,0,0,6" LetterSpacing="1.5"/>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="🏢  Pilih Level yang Diekspor"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="Default: semua level tercentang"
                                           FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnToggleLevels"
                                    Content="▼  Tampilkan" Style="{StaticResource BtnSecondary}"
                                    FontSize="10" Padding="10,5" Click="ToggleLevels_Click"/>
                        </Grid>

                        <!-- Active filter badge -->
                        <Border x:Name="BadgeLevelActive" Background="#EFF6FF" CornerRadius="4"
                                Padding="8,5" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="TxtActiveLevels" FontSize="10"
                                           Foreground="#1D4ED8" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,60,0"/>
                                <Button HorizontalAlignment="Right" Content="✕ Reset"
                                        Style="{StaticResource BtnSecondary}"
                                        FontSize="9" Padding="6,2" Click="ResetLevels_Click"/>
                            </Grid>
                        </Border>

                        <!-- Level list (collapsible) -->
                        <Border x:Name="PanelLevelList" Visibility="Collapsed"
                                Background="#F8FAFC" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkAllLevels" Content="Pilih Semua Level"
                                              FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"
                                              IsChecked="True"
                                              Checked="ChkAllLevels_Checked"
                                              Unchecked="ChkAllLevels_Unchecked"/>
                                    <TextBlock x:Name="TxtLevelSelCount" Text=""
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="10" Foreground="#64748B"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#E2E8F0" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="LevelListBox">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      FontSize="11" Foreground="#374151"
                                                      Margin="0,3,0,0"
                                                      Checked="LevelCheckbox_Changed"
                                                      Unchecked="LevelCheckbox_Changed"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border x:Name="PanelProgress" Visibility="Collapsed" Background="#EFF6FF"
                        CornerRadius="8" Padding="16,12" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="TxtStatus" Text="Memuat..."
                                       FontSize="12" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtPercent" Text="0%"
                                       HorizontalAlignment="Right" FontSize="12"
                                       Foreground="#1D4ED8" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar x:Name="PrgBar" Height="6" Margin="0,8,0,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="#3B82F6" Background="#BFDBFE"/>
                        <TextBlock x:Name="TxtSubStatus" Text=""
                                   FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ FOOTER ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModelInfo" Text="Model: —"
                               FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtCatInfo" Text="Memuat..."
                               FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Batal" Style="{StaticResource BtnSecondary}"
                        Click="Cancel_Click"/>
                <Button Grid.Column="3" x:Name="BtnExport"
                        Style="{StaticResource BtnPrimary}" Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇  " FontSize="13"/>
                        <TextBlock Text="Export ke Excel" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
