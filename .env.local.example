# Isi dengan config dari Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set ke "false" untuk connect ke Firebase asli meskipun sedang dev (npm run dev)
VITE_USE_FIREBASE_EMULATOR=true

# Dari Cloudinary Dashboard (cloudinary.com) + Settings > Upload > Upload presets (mode: Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# AI penghitung objek dari foto (fitur aset). API apa pun yang kompatibel dengan
# OpenAI chat completions + vision. Isi di Vercel → Settings → Environment Variables
# (JANGAN pakai prefix VITE_, supaya API key tidak ikut ke browser).
AI_API_KEY=
AI_MODEL=
# Default https://api.openai.com/v1
AI_BASE_URL=
